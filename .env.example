# Supabase URL (get from your Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (get from your Supabase project settings)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Server-side deal and approval writes, and npm run seed.
# Never prefix this with NEXT_PUBLIC. The browser only receives the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Tavily API key for web search (get from https://tavily.com)
TAVILY_API_KEY=

# TypeSafe API key for AI judgments (get from https://typesafe.ai)
TYPESAFE_API_KEY=

# Stripe secret key - TEST MODE ONLY (get from https://stripe.com)
STRIPE_SECRET_KEY=

# Stripe publishable key - TEST MODE ONLY (not read by the app today)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public origin for share links and Stripe return URLs.
# On Vercel this can be omitted; the app uses the request host.
NEXT_PUBLIC_BASE_URL=
